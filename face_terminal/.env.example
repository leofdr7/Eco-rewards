# Copia este archivo como .env y llénalo. NO lo subas a GitHub.
SUPABASE_URL=https://ocarmdddmhtrrnlmupge.supabase.co
# Supabase > Project Settings > API Keys > service_role / secret (solo en esta PC o en la Jetson)
SUPABASE_SERVICE_ROLE_KEY=
# El mismo código que tiene la ESP32
MACHINE_CODE=ECO-48FM6V
# Cámara: número (0, 1, 2…) o ruta /dev/v4l/by-id/usb-...-video-index0
CAMARA=0
# Tamaño de detección: 640 (más preciso) o 320/480 (más rápido en la Jetson)
DET_SIZE=640
# Similitud mínima para aceptar una cara (sube a 0.5 si confunde personas)
UMBRAL=0.45
# Pon 1 para demostrar solo el reconocimiento local, sin internet
SIN_CONEXION=0
